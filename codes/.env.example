AWS_BEARER_TOKEN_BEDROCK="TOKEN"
OPENAI_API_KEY="TOKEN"
FIREWORKS_API_KEY="TOKEN"

# OPENAI
# FIREWORKS
# BEDROCK
# LOCAL
MODE="OPENAI"

# OpenAI
#   gpt-5-nano
#   gpt-5-mini
#   gpt-5.1-codex-mini
#   gpt-5.4-nano
# Fireworks
#   gpt-oss-20b
#   gpt-oss-120b
#   qwen3-vl-30b-a3b-instruct
# Bedrock
#   openai.gpt-oss-20b-1:0
#   openai.gpt-oss-120b-1:0
#   qwen.qwen3-32b-v1:0
#   qwen.qwen3-coder-30b-a3b-v1:0
# Local
#   Qwen/Qwen3-14B-AWQ
MODEL_ID="gpt-5-nano"

# Bedrock 전용
# 도쿄: ap-northeast-1
# 버지니아: us-east-1
REGION_NAME="ap-northeast-1"

# Local 전용
BASE_URL="http://localhost:8000/v1"

# ==========================================
# Claude Code 테스트 설정 (claude_max / claude_api / claude_bedrock)
# ==========================================

# [공통] 모델 미지정 시 Claude Code 기본 설정 모델 사용
# 지정 시 claude -p --model <값> 으로 전달됨
# 예: claude-sonnet-4-6 / claude-opus-4-7 / claude-haiku-4-5-20251001
CLAUDE_MAX_MODEL="claude-sonnet-4-6"
CLAUDE_API_MODEL="claude-sonnet-4-6"
# Bedrock 은 모델 ID 형식이 다름 (도쿄 리전은 ap-northeast-1. 접두사 필요할 수 있음)
CLAUDE_BEDROCK_MODEL="anthropic.claude-3-5-sonnet-20241022-v2:0"

# [Max 플랜] claude login 으로 로그인 완료 시 추가 설정 불필요
# ~/.claude/ 에 저장된 세션 토큰 자동 사용

# [API Key] Anthropic API 키
CLAUDE_API_KEY="sk-ant-..."

# [Bedrock] claude login -> 3번(Bedrock) 으로 로그인 완료 후 아래 자격증명 입력
# AWS 임시 자격증명(STS)인 경우 SESSION_TOKEN 도 입력
CLAUDE_BEDROCK_AWS_ACCESS_KEY_ID=""
CLAUDE_BEDROCK_AWS_SECRET_ACCESS_KEY=""
CLAUDE_BEDROCK_AWS_SESSION_TOKEN=""
CLAUDE_BEDROCK_AWS_REGION="us-east-1"
